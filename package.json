{
  "name": "schoolscope-england",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @schoolscope/web dev",
    "build": "pnpm --filter @schoolscope/web build",
    "lint": "pnpm -r lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @schoolscope/web test:e2e",
    "db:generate": "pnpm --filter @schoolscope/database generate",
    "db:migrate": "pnpm --filter @schoolscope/database migrate:deploy",
    "db:studio": "pnpm --filter @schoolscope/database studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
