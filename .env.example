# ---------------------------------------------------------------------------
# SchoolScope England — environment variable reference
# Copy to .env.local (web) / .env (ingestor) and fill in LOCAL DEV values only.
# Never commit a filled-in copy of this file. Production values live in
# GitHub Actions secrets and Vercel project environment variables, not here.
# ---------------------------------------------------------------------------

# --- Database (apps/web, packages/database) ---------------------------------
# Scoped, least-privilege application user. Never the bootstrap/admin URL.
DATABASE_URL="postgresql://school_app:password@localhost:26257/school_intelligence?sslmode=verify-full"

# --- Database (services/ingestor, migrations) --------------------------------
# Used only by CI / manual migration workflow and the ingestion service.
INGEST_DATABASE_URL="postgresql://school_ingestor:password@localhost:26257/school_intelligence?sslmode=verify-full"
MIGRATION_DATABASE_URL="postgresql://school_migrator:password@localhost:26257/school_intelligence?sslmode=verify-full"

# --- Web app public config ----------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# --- Server config -------------------------------------------------------------
POSTCODE_GEOCODER="postcodes.io"
CATCHMENT_BOUNDARY_WARNING_METRES="75"
LOG_LEVEL="info"

# --- CI / ingestion toggles (set as GitHub repository variables) --------------
INGESTION_ENABLED="true"
CATCHMENT_INGESTION_ENABLED="true"

# --- Bootstrap only (NEVER stored in this file, NEVER committed) -------------
# Set transiently in your own shell when running scripts/bootstrap-cockroachdb.sh
# COCKROACH_BOOTSTRAP_URL=
